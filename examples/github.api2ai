openapi "./openapi/github-user-min.openapi.yaml"
baseUrl "https://api.github.com"

auth bearerSealed {
    in: header
    name: "Authorization"
    prefix: "Bearer "
    privateKeyEnv: "API2AI_SEAL_PRIVATE_KEY"
}

GET "/user" {
    toolName: "getGitHubAuthenticatedUser"
    intent: "return the GitHub user profile for the authenticated PAT; use to confirm which account the token represents before calling repo-scoped tools"
    example: "No path or query parameters — only sealedCredential"
    summary: "Get the authenticated user"
}

GET "/user/repos" {
    toolName: "listGitHubUserRepos"
    intent: "list repositories the authenticated PAT can access; use to find owner/repo and to debug 404 on GET /repos/{owner}/{repo}"
    example: "First page, 10 per page: query per_page=10 page=1"
    summary: "List repositories for the authenticated user"
}

GET "/repos/{owner}/{repo}" {
    toolName: "getGitHubRepository"
    intent: "fetch GitHub repository metadata when the PAT can read the repo"
    example: "Get public repo octocat/Hello-World"
    summary: "Get a repository"
}
