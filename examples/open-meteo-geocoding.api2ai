openapi "./openapi/open-meteo-geocoding.openapi.yaml"
baseUrl "https://geocoding-api.open-meteo.com"


GET "/v1/search" {
    toolName: "openMeteoGeocodeSearch"
    intent: "resolve a location name to latitude and longitude coordinates"
    example: "Find coordinates for Bernstein, Burgenland, Austria"
    includeResponses
}

