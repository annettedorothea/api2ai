{
    "name": "api-2-ai-dsl-workspace",
    "description": "Base workspace package",
    "version": "0.0.1",
    "license": "MIT",
    "type": "module",
    "private": true,
    "scripts": {
        "clean": "npm run clean --workspaces",
        "postinstall": "node scripts/install-git-hooks.mjs",
        "install:hooks": "node scripts/install-git-hooks.mjs",
        "install:github-https": "node scripts/npm-install-github-https.mjs",
        "watch": "tsc -b tsconfig.build.json --watch",
        "build": "tsc -b tsconfig.build.json && npm run bundle:mcp-runtime && npm run build --workspaces",
        "bundle:mcp-runtime": "esbuild @core2ai/core/mcp-host/standalone-entry --bundle --platform=node --format=esm --banner:js=\"#!/usr/bin/env node\" --outfile=packages/cli/resources/mcp-serve-emitted.mjs --external:@modelcontextprotocol/sdk --external:zod",
        "build:clean": "npm run clean && npm run build",
        "extension:vsix": "npm run --workspace packages/extension extension:vsix",
        "extension:release:vsix": "NAME=$(node -p \"require('./packages/extension/package.json').name\") && VERSION=$(node -p \"require('./packages/extension/package.json').version\") && gh release create \"${NAME}-${VERSION}\" \"packages/extension/${NAME}-${VERSION}.vsix\" --title \"${NAME} ${VERSION}\" --notes \"Internal test build of the api2ai Cursor/VS Code extension.\" --prerelease",
        "langium:generate": "npm run --workspace packages/language langium:generate",
        "langium:watch": "npm run --workspace packages/language langium:watch",
        "test": "npm run langium:generate && npm run build && npm run test:unit && npm run test:e2e",
        "test:unit": "npm run --workspace packages/language test && npm run --workspace packages/cli test",
        "test:e2e": "npm run test:mcp:mock-api",
        "test:coverage": "npm run --workspace packages/language test:coverage && npm run --workspace packages/cli test:coverage",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc -b tsconfig.build.json --pretty false",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "check": "npm run format:check && npm run typecheck && npm run lint",
        "test:smoke": "node ./packages/cli/bin/cli.js smoke-generated ./packages/extension/demos/generated/tools/open-meteo-tools.mjs openMeteoForecast",
        "test:smoke:tmdb": "node ./packages/cli/bin/cli.js smoke-generated ./packages/extension/demos/generated/tools/tmdb-tools.mjs searchTmdbMovies '{\"query\":{\"query\":\"Dune\"}}'",
        "test:smoke:mock-api": "node ./packages/cli/bin/cli.js smoke-generated ./packages/extension/demos/generated/tools/mock-api-tools.mjs listCustomerOrders",
        "test:mcp": "OPEN_METEO_BASE_URL=https://api.open-meteo.com node ./packages/extension/demos/generated/cli/mcp-serve.mjs ./packages/extension/demos/generated/tools/open-meteo-tools.mjs --base-url-env OPEN_METEO_BASE_URL",
        "test:mcp:mock-api": "node ./packages/cli/out/test/e2e/mcp-smoke-mock-api.js"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "~20.17.48",
        "@vitest/coverage-v8": "^3.1.4",
        "esbuild": "^0.25.12",
        "eslint": "^10.4.0",
        "prettier": "^3.8.3",
        "shx": "~0.4.0",
        "typescript": "~5.8.3",
        "typescript-eslint": "^8.59.4"
    },
    "workspaces": [
        "packages/language",
        "packages/cli",
        "packages/extension"
    ]
}
