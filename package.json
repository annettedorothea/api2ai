{
    "name": "api-2-ai-dsl-workspace",
    "description": "Base workspace package",
    "version": "0.0.1",
    "type": "module",
    "private": true,
    "scripts": {
        "clean": "npm run clean --workspaces",
        "watch": "tsc -b tsconfig.build.json --watch",
        "build": "tsc -b tsconfig.build.json && npm run build --workspaces",
        "build:clean": "npm run clean && npm run build",
        "langium:generate": "npm run --workspace packages/language langium:generate",
        "langium:watch": "npm run --workspace packages/language langium:watch",
        "generate:petstore-tools": "node ./packages/cli/bin/cli.js generate ./examples/petstore.api2ai ./examples/generated/petstore-tools.ts",
        "test": "npm run --workspace packages/language test",
        "test:smoke": "node ./packages/cli/bin/cli.js smoke ./examples/petstore.api2ai getPetById @./examples/petstore-smoke-args.json",
        "test:mcp": "node ./packages/cli/bin/cli.js mcp-serve ./examples/petstore.api2ai"
    },
    "devDependencies": {
        "@types/node": "~20.17.48",
        "shx": "~0.4.0",
        "typescript": "~5.8.3"
    },
    "workspaces": [
        "packages/language",
        "packages/cli",
        "packages/extension"
    ]
}
