{
    "name": "api-2-ai-dsl-workspace",
    "description": "Base workspace package",
    "version": "0.0.1",
    "type": "module",
    "private": true,
    "scripts": {
        "clean": "npm run clean --workspaces",
        "watch": "tsc -b tsconfig.build.json --watch",
        "build": "tsc -b tsconfig.build.json && npm run bundle:mcp-runtime && npm run build --workspaces",
        "bundle:mcp-runtime": "esbuild packages/cli/mcp-bundle/mcp-standalone-entry.ts --bundle --platform=node --format=esm --banner:js=\"#!/usr/bin/env node\" --outfile=packages/cli/resources/mcp-serve-emitted.mjs --external:@modelcontextprotocol/sdk --external:zod",
        "build:clean": "npm run clean && npm run build",
        "langium:generate": "npm run --workspace packages/language langium:generate",
        "langium:watch": "npm run --workspace packages/language langium:watch",
        "generate:spaceflight-tools": "node ./packages/cli/bin/cli.js generate ./examples/spaceflight-news.api2ai ./examples/generated/tools/spaceflight-news-tools.ts",
        "generate:tmdb-tools": "node ./packages/cli/bin/cli.js generate ./examples/tmdb.api2ai ./examples/generated/tools/tmdb-tools.ts",
        "generate:github-tools": "node ./packages/cli/bin/cli.js generate ./examples/github.api2ai ./examples/generated/tools/github-tools.ts",
        "generate:open-meteo-tools": "node ./packages/cli/bin/cli.js generate ./examples/open-meteo.api2ai ./examples/generated/tools/open-meteo-tools.ts",
        "generate:open-meteo-geocoding-tools": "node ./packages/cli/bin/cli.js generate ./examples/open-meteo-geocoding.api2ai ./examples/generated/tools/open-meteo-geocoding-tools.ts",
        "generate:customer-portal-tools": "node ./packages/cli/bin/cli.js generate ./examples/customer-portal.api2ai ./examples/generated/tools/customer-portal-tools.ts",
        "test": "npm run --workspace packages/language test",
        "test:smoke": "node ./packages/cli/bin/cli.js smoke-generated ./examples/generated/tools/open-meteo-tools.mjs openMeteoForecast",
        "test:smoke:tmdb": "node ./packages/cli/bin/cli.js smoke-generated ./examples/generated/tools/tmdb-tools.mjs searchTmdbMovies '{\"query\":{\"query\":\"Dune\"}}'",
        "test:mcp": "node ./examples/generated/cli/mcp-serve.mjs ./examples/generated/tools/open-meteo-tools.mjs",
        "extension:vsix": "npm run langium:generate && npm run build && npm run package:vsix -w packages/extension"
    },
    "devDependencies": {
        "@types/node": "~20.17.48",
        "esbuild": "^0.25.12",
        "shx": "~0.4.0",
        "typescript": "~5.8.3"
    },
    "workspaces": [
        "packages/language",
        "packages/cli",
        "packages/extension"
    ]
}
