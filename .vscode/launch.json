{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run api2ai Extension",
            "type": "extensionHost",
            "request": "launch",
            "preLaunchTask": "Build api-2-ai-dsl",
            "args": [
                "${workspaceFolder}/packages/extension/demos",
                "--extensionDevelopmentPath=${workspaceFolder}/packages/extension"
            ],
            "sourceMaps": true,
            "outFiles": [
                "${workspaceFolder}/packages/language/out/**/*.js",
                "${workspaceFolder}/packages/extension/out/**/*.js"
            ]
        },
        {
            "name": "Attach: api2ai Language Server (6009)",
            "type": "node",
            "port": 6009,
            "request": "attach",
            "hidden": true,
            "skipFiles": ["<node_internals>/**"],
            "sourceMaps": true,
            "outFiles": [
                "${workspaceFolder}/packages/language/out/**/*.js",
                "${workspaceFolder}/packages/extension/out/**/*.js",
                "${workspaceFolder}/node_modules/langium"
            ]
        },
        {
            "name": "api2ai: completion debug log",
            "type": "extensionHost",
            "request": "launch",
            "hidden": true,
            "preLaunchTask": "Build api-2-ai-dsl",
            "args": [
                "${workspaceFolder}/packages/extension/demos",
                "--extensionDevelopmentPath=${workspaceFolder}/packages/extension"
            ],
            "env": { "API2AI_DSL_DEBUG_COMPLETION": "1" },
            "sourceMaps": true,
            "outFiles": [
                "${workspaceFolder}/packages/language/out/**/*.js",
                "${workspaceFolder}/packages/extension/out/**/*.js"
            ]
        }
    ]
}
