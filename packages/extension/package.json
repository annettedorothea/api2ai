{
    "name": "vscode-api2ai",
    "displayName": "api2ai",
    "description": "Language support and code generation for the .api2ai DSL (OpenAPI → MCP tools).",
    "version": "0.1.0",
    "publisher": "api2ai",
    "license": "BUSL-1.1",
    "icon": "icon.png",
    "author": {
        "name": "Annette Pohl"
    },
    "type": "module",
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "api-2-ai-dsl",
                "aliases": [
                    "api2ai-dsl",
                    "api-2-ai-dsl"
                ],
                "extensions": [
                    ".api2ai"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "api-2-ai-dsl",
                "scopeName": "source.api-2-ai-dsl",
                "path": "syntaxes/api-2-ai-dsl.tmLanguage.json"
            }
        ],
        "configurationDefaults": {
            "[api-2-ai-dsl]": {
                "editor.wordBasedSuggestions": "off"
            }
        },
        "commands": [
            {
                "command": "api2ai.generateTools",
                "title": "Generate tool code (.ts + MCP host)"
            },
            {
                "command": "api2ai.createDemoWorkspace",
                "title": "api2ai: Create demo workspace (MCP examples)"
            }
        ]
    },
    "main": "./out/extension/main.cjs",
    "scripts": {
        "clean": "shx rm -fr *.tsbuildinfo out syntaxes",
        "vscode:prepublish": "npm run build",
        "build:prepare": "shx mkdir -p ./syntaxes/ && shx cp -f ../language/syntaxes/api-2-ai-dsl.tmLanguage.json ./syntaxes/api-2-ai-dsl.tmLanguage.json",
        "build": "npm run build:prepare && tsc -b tsconfig.json && node scripts/esbuild.mjs && node scripts/embed-cli-bundle.mjs && node scripts/verify-demos-bundle.mjs",
        "vsix:prepare": "node scripts/vsix-prepare.mjs",
        "vsix:build": "node scripts/vsix-build.mjs",
        "vsix:release": "node scripts/vsix-release.mjs"
    },
    "dependencies": {
        "api-2-ai-dsl-language": "*",
        "vscode-languageclient": "~9.0.1",
        "vscode-languageserver": "~9.0.1"
    },
    "devDependencies": {
        "@types/vscode": "~1.75.0",
        "@vscode/vsce": "^3.9.2",
        "esbuild": "~0.28.0"
    },
    "vsce": {
        "dependencies": false
    }
}
