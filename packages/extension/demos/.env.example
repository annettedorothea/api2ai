# Copy to .env.local and set real tokens (never commit .env.local).
TMDB_ACCESS_TOKEN=set-in-env-local
GITHUB_TOKEN=set-in-env-local
MOCK_API_ACCESS_TOKEN=set-in-env-local

# Stateless HTTP MCP hosts — header name for client credential pass-through (not the token value)
MCP_AUTH_HEADER=x-api-token

# Stateless HTTP MCP hosts — start hosts manually; URLs in mcp.json match these defaults
OPEN_METEO_HTTP_PORT=3848
SPACEFLIGHT_NEWS_HTTP_PORT=3849
MOCK_API_HTTP_PORT=3850
OPEN_METEO_GEOCODING_HTTP_PORT=3851

# mock-api backend + OAuth IDP + oauth-http MCP host (oauth-api2ai-mock-api in mcp.json)
MOCK_API_PORT=3847
MOCK_API_OAUTH_IDP_PORT=3860
MOCK_API_OAUTH_IDP_URL=http://127.0.0.1:3860
MOCK_API_OAUTH_HTTP_PORT=3870
MOCK_API_JWT_SECRET=demo-mock-api-secret
