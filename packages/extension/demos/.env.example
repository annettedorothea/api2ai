# Copy to .env.local and set real tokens (never commit .env.local).
TMDB_ACCESS_TOKEN=set-in-env-local
GITHUB_TOKEN=set-in-env-local

# Stateless HTTP MCP — client credential header name (value: mcp.json headers or below)
MCP_AUTH_HEADER=x-api-token
TODO_API_KEY=demo-todo-api-key

# Local backends
SHOPPING_API_PORT=3847
SHOPPING_API_BASE_URL=http://127.0.0.1:3847
TODO_API_PORT=3852
TODO_API_BASE_URL=http://127.0.0.1:3852

# Stateless HTTP MCP hosts (init starts these)
SPACEFLIGHT_NEWS_HTTP_PORT=3849
TODO_API_HTTP_PORT=3853

# shopping-api OAuth IDP + oauth-http MCP host
SHOPPING_API_OAUTH_IDP_PORT=3860
SHOPPING_API_OAUTH_IDP_URL=http://127.0.0.1:3860
SHOPPING_API_OAUTH_HTTP_PORT=3870
SHOPPING_API_JWT_SECRET=demo-shopping-api-secret
# OAUTH_TOKEN_VALIDATION=hs256|oidc
# OAUTH_ISSUER=http://127.0.0.1:3860
