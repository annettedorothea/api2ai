# Copy to .env via npm run init or npm run start — never commit .env with real tokens.

# open-meteo — public weather API (no auth)
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_HTTP_PORT=3850

# open-meteo-geocoding — public geocoding API (no auth)
OPEN_METEO_GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com
OPEN_METEO_GEOCODING_HTTP_PORT=3851

# spaceflight-news — public upstream API (no auth)
SPACEFLIGHT_NEWS_BASE_URL=https://api.spaceflightnewsapi.net
SPACEFLIGHT_NEWS_HTTP_PORT=3849

# github — passthrough MCP; PAT injected by host (--auth-env)
GITHUB_TOKEN=
GITHUB_BASE_URL=https://api.github.com
GITHUB_HTTP_PORT=3854

# tmdb — passthrough MCP; API key injected by host
TMDB_ACCESS_TOKEN=
TMDB_BASE_URL=https://api.themoviedb.org
TMDB_HTTP_PORT=3855

# xquik — passthrough MCP; optional API key (warns on start if empty)
XQUIK_API_KEY=
XQUIK_BASE_URL=https://xquik.com
XQUIK_HTTP_PORT=3859
XQUIK_MCP_AUTH_HEADER=x-api-key

# todo — mock REST API + passthrough MCP (header must match TODO_API_KEY)
TODO_API_PORT=3852
TODO_API_BASE_URL=http://127.0.0.1:3852
TODO_API_KEY=demo-todo-api-key
TODO_MCP_AUTH_HEADER=x-api-token
TODO_HTTP_PORT=3853

# cakes — OAuth MCP + upstream JWT API; mock IdP on :3860
BOOKINGS_OAUTH_IDP_PORT=3860
BOOKINGS_OAUTH_IDP_URL=http://127.0.0.1:3860
CAKES_API_PORT=3856
CAKES_API_BASE_URL=http://127.0.0.1:3856
CAKES_API_JWT_SECRET=demo-bookings-secret
CAKES_OAUTH_HTTP_PORT=3874

# bookings — OAuth MCP + mock API; OIDC IdP on :3861 (RS256, same server.mjs)
BOOKINGS_API_PORT=3847
BOOKINGS_API_BASE_URL=http://127.0.0.1:3847
BOOKINGS_API_JWT_SECRET=demo-bookings-secret
BOOKINGS_OAUTH_IDP_OIDC_PORT=3861
BOOKINGS_OAUTH_IDP_OIDC_URL=http://127.0.0.1:3861
BOOKINGS_OAUTH_HTTP_PORT=3872

# banking — OAuth MCP + portal JWT API; IdP token exchange on shared oauth-idp (:3860)
BANKING_API_PORT=3858
BANKING_API_BASE_URL=http://127.0.0.1:3858
BANKING_API_JWT_SECRET=demo-banking-portal-secret
BANKING_OAUTH_IDP_URL=http://127.0.0.1:3860
BANKING_OAUTH_HTTP_PORT=3873
BANKING_TOKEN_EXCHANGE_URL=http://127.0.0.1:3860/portal/token-exchange

# test — coverage harness for /test-all
TEST_API_PORT=3857
TEST_API_BASE_URL=http://127.0.0.1:3857
TEST_API_KEY=demo-test-api-key

# OAuth redirect allowlist — Cursor (IDE + CLI loopback) + MCP Inspector (shared by cakes/bookings IdPs)
# Inspector redirect is read-only (localhost:6274) — must list both localhost and 127.0.0.1
OAUTH_IDP_REDIRECT_URIS=cursor://anysphere.cursor-mcp/oauth/callback,http://localhost:8787/callback,http://localhost:6274/oauth/callback,http://localhost:6274/oauth/callback/debug,http://127.0.0.1:6274/oauth/callback,http://127.0.0.1:6274/oauth/callback/debug

# Browser CORS for oauth HTTP host + demo IdPs (optional — unset reflects request Origin)
# MCP_HTTP_CORS_ORIGIN=http://localhost:6274
