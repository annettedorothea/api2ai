# Copy to .env.local — never commit secrets.

# --- HTTP MCP PAT relay: github, tmdb (token read by host --auth-env from .env.local) ---
GITHUB_TOKEN=
TMDB_ACCESS_TOKEN=
GITHUB_BASE_URL=https://api.github.com
GITHUB_HTTP_PORT=3854
TMDB_BASE_URL=https://api.themoviedb.org
TMDB_HTTP_PORT=3855

# --- HTTP MCP public upstreams: open-meteo ---
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_HTTP_PORT=3850
OPEN_METEO_GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com
OPEN_METEO_GEOCODING_HTTP_PORT=3851

# --- HTTP MCP client auth header (todo: must match Cursor mcp.json headers.*) ---
TODO_MCP_AUTH_HEADER=x-api-token
# Optional global fallback when a demo-specific var is unset:
# MCP_AUTH_HEADER=x-api-token
# --- HTTP todo passthrough: MCP header value must match TODO_API_KEY (verifyTodoCredentials) ---
TODO_API_KEY=demo-todo-api-key

# --- Mock API backends (started by start) ---
TODO_API_PORT=3852
TODO_API_BASE_URL=http://127.0.0.1:3852
BOOKINGS_API_PORT=3847
BOOKINGS_API_BASE_URL=http://127.0.0.1:3847
CAKES_API_PORT=3856
CAKES_API_BASE_URL=http://127.0.0.1:3856
BANKING_API_PORT=3858
BANKING_API_BASE_URL=http://127.0.0.1:3858

# --- JWT (cakes upstream API, bookings mock, get-token.mjs for dev) ---
BOOKINGS_API_JWT_SECRET=demo-bookings-secret
CAKES_API_JWT_SECRET=demo-bookings-secret

# --- HTTP MCP hosts: spaceflight-news, todo ---
SPACEFLIGHT_NEWS_BASE_URL=https://api.spaceflightnewsapi.net
SPACEFLIGHT_NEWS_HTTP_PORT=3849
TODO_HTTP_PORT=3853

# --- OAuth IdP: :3860 cakes OAuth flow, :3861 bookings (oidc) ---
BOOKINGS_OAUTH_IDP_PORT=3860
BOOKINGS_OAUTH_IDP_URL=http://127.0.0.1:3860
BOOKINGS_OAUTH_IDP_OIDC_PORT=3861
BOOKINGS_OAUTH_IDP_OIDC_URL=http://127.0.0.1:3861
ENTERPRISE_IDP_PORT=3862
ENTERPRISE_IDP_URL=http://127.0.0.1:3862

# --- Open WebUI (native pip/pipx on host — not Docker; not part of this repo) ---
OPEN_WEBUI_PORT=3000
# If npm cannot find open-webui on PATH, set the full command (without serve --port):
# OPEN_WEBUI_COMMAND=open-webui
# OPEN_WEBUI_COMMAND=python3.12 -m open_webui
# OPEN_WEBUI_DATA_DIR=~/.open-webui-data
# OPEN_WEBUI_SECRET_PATH=~/.open-webui-secret
# OPEN_WEBUI_SKIP_KILL=1

# --- OAuth IdP redirect allowlist (oauth-idp + oauth-idp-oidc share server.mjs) ---
# Comma-separated. Exact URI, or prefix rule ending with * (Open WebUI MCP callbacks).
OAUTH_IDP_REDIRECT_URIS=cursor://anysphere.cursor-mcp/oauth/callback
# Open WebUI — uncomment and restart demos (see README § Open WebUI):
# OAUTH_IDP_REDIRECT_URIS=cursor://anysphere.cursor-mcp/oauth/callback,http://localhost:3000/oauth/clients/mcp:*,http://127.0.0.1:3000/oauth/clients/mcp:*

# --- OAuth MCP hosts: bookings, cakes, banking ---
BOOKINGS_OAUTH_HTTP_PORT=3872
CAKES_OAUTH_HTTP_PORT=3874
BANKING_OAUTH_HTTP_PORT=3876
