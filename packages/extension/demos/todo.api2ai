openapi "./openapi/todo-api.openapi.yaml"

auth {
    in: header
    name: "x-api-key"
    prefix: ""
}

GET "/categories" {
    toolName: listCategories
    access: protected
    intent: '''
        List todo categories. Requires API key (MCP x-api-token → x-api-key).
    '''
    summary: "List todo categories"
    example: "List todo categories"
    response: '''
        HTTP 200 — top-level categories array. Each category: id, name, color (ids: work, home, errands).
        Documented errors:
        HTTP 401 — Missing or invalid API key
    '''
}

GET "/todos" {
    toolName: listTodos
    access: protected
    intent: '''
        List todos; optional filter by status (open|done) or categoryId.
    '''
    summary: "List todos"
    example: "List open todos"
    params: {
        status: {
            description: '''
                Optional query filter: open or done only (OpenAPI enum).
            '''
            example: "open"
        }
        categoryId: {
            description: '''
                Optional query filter by category id — from listCategories categories[].id (work, home, errands).
            '''
            example: "work"
        }
    }
    response: '''
        HTTP 200 — top-level todos array. Each todo: id, title, status (open|done), categoryId, dueDate.
        Documented errors:
        HTTP 401 — Missing or invalid API key
    '''
}

GET "/categories/{categoryId}/todos" {
    toolName: listTodosByCategory
    access: protected
    intent: '''
        List todos in one category. Optional query status: open or done.
    '''
    summary: "List todos by category"
    example: "List open todos in category work"
    params: {
        categoryId: {
            description: '''
                Category id (path). Values: work, home, errands — from listCategories categories[].id.
            '''
            example: "work"
        }
        status: {
            description: '''
                Optional query filter: open or done only.
            '''
            example: "open"
        }
    }
    response: '''
        HTTP 200 — top-level categoryId and todos array (same todo shape as listTodos).
        Documented errors:
        HTTP 401 — Missing or invalid API key
        HTTP 404 — Unknown category (invalid categoryId)
    '''
}

GET "/todos/{todoId}" {
    toolName: getTodo
    access: protected
    intent: '''
        Fetch one todo by path todoId (e.g. t-1).
    '''
    summary: "Get todo by id"
    example: "Get todo t-1"
    params: {
        todoId: {
            description: '''
                Todo id (path) from listTodos todos[].id or createTodo response todo.id.
            '''
            example: "t-1"
        }
    }
    response: '''
        HTTP 200 — top-level property todo (id, title, status, categoryId, dueDate).
        Documented errors:
        HTTP 401 — Missing or invalid API key
        HTTP 404 — Todo not found
    '''
}

POST "/todos" {
    toolName: createTodo
    access: protected
    intent: '''
        Create a todo. Use response todo.id for updateTodo or deleteTodo.
    '''
    summary: "Create todo"
    example: "Create todo Buy milk in errands"
    body: '''
        JSON object. Required: title (string), categoryId (work, home, or errands).
        Optional: status (open|done), dueDate (ISO date YYYY-MM-DD).
        Do not send id — server assigns it (e.g. t-5).
    '''
    response: '''
        HTTP 201 — top-level property todo with generated id (use todo.id next).
        Documented errors:
        HTTP 400 — Invalid input
        HTTP 401 — Missing or invalid API key
        HTTP 404 — Unknown categoryId
    '''
}

PATCH "/todos/{todoId}" {
    toolName: updateTodo
    access: protected
    intent: '''
        Update a todo by path todoId (from createTodo or listTodos).
    '''
    summary: "Update todo"
    example: "Mark todo t-1 as done"
    params: {
        todoId: {
            description: '''
                Todo id to update (path) — from createTodo todo.id or listTodos todos[].id.
            '''
            example: "t-1"
        }
    }
    body: '''
        JSON object; send only fields to change (all optional): title, status (open|done),
        categoryId (work, home, errands), dueDate (ISO date YYYY-MM-DD).
        At least one field required. Do not send id in body.
    '''
    response: '''
        HTTP 200 — top-level property todo with updated fields.
        Documented errors:
        HTTP 400 — Invalid input
        HTTP 401 — Missing or invalid API key
        HTTP 404 — Todo or category not found
    '''
}

DELETE "/todos/{todoId}" {
    toolName: deleteTodo
    access: protected
    intent: '''
        Delete a todo by path todoId.
    '''
    summary: "Delete todo"
    example: "Delete todo t-2"
    params: {
        todoId: {
            description: '''
                Todo id to delete (path) — from createTodo todo.id or listTodos todos[].id.
            '''
            example: "t-2"
        }
    }
    response: '''
        HTTP 200 — top-level todoId and deleted: true.
        Documented errors:
        HTTP 401 — Missing or invalid API key
        HTTP 404 — Todo not found
    '''
}
