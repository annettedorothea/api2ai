openapi "./openapi/todo-api.openapi.yaml"

auth {
    in: header
    name: "x-api-key"
    prefix: ""
    hooks: {
        verifyCredential: true
    }
}

GET "/categories" {
    toolName: listCategories
    access: protected
    intent: '''
        List todo categories before createTodo or when filtering by categoryId.
        Response categories[].id values: work, home, errands.
    '''
    summary: "List todo categories"
    example: "List todo categories"
    response: '''
        HTTP 200 — top-level categories array. Each category: id, name, color (ids: work, home, errands).
        Documented errors:
        HTTP 401 — Missing or invalid API key
    '''
}

GET "/todos" {
    toolName: listTodos
    access: protected
    hooks: {
        afterToolCall: true
    }
    intent: '''
        List todos. Optional API query filters: status (open|done), categoryId (work|home|errands).
        Optional MCP-only titleContains (hookParams) filters titles client-side after the HTTP response — not sent to the API.
        Use todos[].id (e.g. t-1) as pathParams.todoId for getTodo, updateTodo, deleteTodo.
        Call shape: query optional; titleContains optional top-level MCP arg.
    '''
    summary: "List todos"
    example: "List todos whose title contains milk"
    params: {
        status: {
            description: '''
                Optional query filter: open or done only. Omit to return all statuses.
            '''
            example: "open"
        }
        categoryId: {
            description: '''
                Optional query filter by category id — from listCategories categories[].id (work, home, errands).
            '''
            example: "work"
        }
    }
    hookParams: {
        titleContains: {
            type: string
            description: '''
                Optional client-side title substring filter (case-insensitive). Not an OpenAPI/API query param.
            '''
            example: "Buy"
        }
    }
    response: '''
        HTTP 200 — top-level todos array. Each todo: id, title, status (open|done), categoryId, dueDate.
        When titleContains is set, afterToolCall returns only matching todos.
        Documented errors:
        HTTP 401 — Missing or invalid API key
    '''
}

GET "/categories/{categoryId}/todos" {
    toolName: listTodosByCategory
    access: protected
    intent: '''
        List todos in one category. categoryId is a path param (work, home, or errands).
        Optional query.status: open or done.
        Call shape: pathParams.categoryId required; query.status optional.
    '''
    summary: "List todos by category"
    example: "List open todos in category work"
    params: {
        categoryId: {
            description: '''
                Category id (path param pathParams.categoryId). Values: work, home, errands — from listCategories.
                Do NOT use pathParams.id or pathParams.category.
            '''
            example: "work"
        }
        status: {
            description: '''
                Optional query filter: open or done only.
            '''
            example: "open"
        }
    }
    response: '''
        HTTP 200 — top-level categoryId and todos array (same todo shape as listTodos).
        Documented errors:
        HTTP 401 — Missing or invalid API key
        HTTP 404 — Unknown category (invalid categoryId)
    '''
}

GET "/todos/{todoId}" {
    toolName: getTodo
    access: protected
    intent: '''
        Fetch one todo by id. Get todoId from listTodos todos[].id or createTodo todo.id.
        Call shape: pathParams.todoId required — e.g. pathParams: { "todoId": "t-1" }.
        Do NOT use pathParams.id.
    '''
    summary: "Get todo by id"
    example: "Get todo t-1"
    params: {
        todoId: {
            description: '''
                Todo id as pathParams.todoId (NOT pathParams.id). From listTodos todos[].id or createTodo todo.id.
            '''
            example: "t-1"
        }
    }
    response: '''
        HTTP 200 — top-level property todo (id, title, status, categoryId, dueDate).
        Documented errors:
        HTTP 401 — Missing or invalid API key
        HTTP 404 — Todo not found
    '''
}

POST "/todos" {
    toolName: createTodo
    access: protected
    intent: '''
        Create a todo. Save response todo.id for later updateTodo or deleteTodo.
        Call shape: body required — e.g. body: { "title": "Buy milk", "categoryId": "errands" }.
        categoryId must be work, home, or errands (from listCategories).
    '''
    summary: "Create todo"
    example: "Create todo Buy milk in errands"
    body: '''
        JSON body object (required). Required fields: title (string), categoryId (work|home|errands).
        Optional: status (open|done, default open), dueDate (ISO date YYYY-MM-DD).
        Do not send id in body — server assigns it (e.g. t-5).
        Example: { "title": "Buy milk", "categoryId": "errands", "status": "open", "dueDate": "2026-06-15" }
    '''
    response: '''
        HTTP 201 — top-level property todo with generated id (use todo.id next).
        Documented errors:
        HTTP 400 — Invalid input
        HTTP 401 — Missing or invalid API key
        HTTP 404 — Unknown categoryId
    '''
}

PATCH "/todos/{todoId}" {
    toolName: updateTodo
    access: protected
    intent: '''
        Update a todo. Requires pathParams.todoId from listTodos todos[].id (e.g. t-1) and body with at least one field.
        Do NOT use pathParams.id — the path key is todoId.
        Example — mark done: pathParams: { "todoId": "t-1" }, body: { "status": "done" }.
        Example — rename: pathParams: { "todoId": "t-2" }, body: { "title": "Buy organic milk" }.
    '''
    summary: "Update todo"
    example: "Mark todo t-1 as done"
    params: {
        todoId: {
            description: '''
                Todo id as pathParams.todoId (NOT pathParams.id). From listTodos todos[].id or createTodo todo.id.
            '''
            example: "t-1"
        }
    }
    body: '''
        JSON body object (required). Send only fields to change; at least one required.
        Fields: status (open|done), title (string), categoryId (work|home|errands), dueDate (YYYY-MM-DD).
        Do not send id in body.
        Example mark done: { "status": "done" }
        Example reopen: { "status": "open" }
    '''
    response: '''
        HTTP 200 — top-level property todo with updated fields.
        Documented errors:
        HTTP 400 — Invalid input
        HTTP 401 — Missing or invalid API key
        HTTP 404 — Todo or category not found
    '''
}

DELETE "/todos/{todoId}" {
    toolName: deleteTodo
    access: protected
    intent: '''
        Delete a todo permanently. Requires pathParams.todoId from listTodos todos[].id.
        Do NOT use pathParams.id.
        Call shape: pathParams: { "todoId": "t-2" } — no body required.
    '''
    summary: "Delete todo"
    example: "Delete todo t-2"
    params: {
        todoId: {
            description: '''
                Todo id as pathParams.todoId (NOT pathParams.id). From listTodos todos[].id or createTodo todo.id.
            '''
            example: "t-2"
        }
    }
    response: '''
        HTTP 200 — top-level todoId and deleted: true.
        Documented errors:
        HTTP 401 — Missing or invalid API key
        HTTP 404 — Todo not found
    '''
}

GET "/todos/export.pdf" {
    toolName: exportTodosPdf
    access: protected
    hooks: {
        afterToolCall: true
    }
    intent: '''
        Download the current todo list as a PDF (optional filters: status, categoryId — same as listTodos).
        afterToolCall saves the PDF under the OS temp dir and returns path metadata (no Base64 data in the MCP result).
        Prefer this when the user asks to export or download todos as a file.
    '''
    summary: "Export todos as PDF"
    example: "Export open todos as PDF"
    params: {
        status: {
            description: '''
                Optional query filter: open or done only. Omit to export all statuses.
            '''
            example: "open"
        }
        categoryId: {
            description: '''
                Optional query filter by category id — from listCategories (work, home, errands).
            '''
            example: "work"
        }
    }
    response: '''
        HTTP 200 — PDF saved by afterToolCall; result includes kind, contentType, filename, byteLength, path
        (Base64 data stripped after save).
        Documented errors:
        HTTP 401 — Missing or invalid API key
    '''
}
