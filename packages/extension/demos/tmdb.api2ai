openapi "./openapi/tmdb.openapi.json"

auth {
    in: header
    name: "Authorization"
    prefix: "Bearer "
}

GET "/3/search/movie" {
    toolName: searchTmdbMovies
    access: protected
    intent: "search TMDB movies by title"
    summary: "Search movies by title"
    example: "Find movies named Dune"
}

GET "/3/movie/popular" {
    toolName: getPopularTmdbMovies
    access: protected
    intent: "retrieve currently popular TMDB movies"
    summary: "Popular movies"
    example: "Show popular movies"
}

GET "/3/movie/{movie_id}" {
    toolName: getTmdbMovieDetails
    access: protected
    intent: "retrieve details for a TMDB movie by id"
    summary: "Movie details by ID"
    example: "Get details for movie id 693134"
}

GET "/3/movie/{movie_id}/credits" {
    toolName: getTmdbMovieCredits
    access: protected
    intent: "retrieve cast and crew credits for a TMDB movie"
    summary: "Movie cast and crew"
    example: "Who played in movie id 693134?"
}

GET "/3/discover/movie" {
    toolName: discoverTmdbMovies
    access: protected
    intent: '''
        - Discover movies with OpenAPI query filters (genre, year, vote_average, sort_by, etc.).
        - Use getTmdbMovieGenres first when the user names a genre in natural language.
        - Prefer searchTmdbMovies for a known title; use this tool for "best sci-fi 2024" style queries.
        - Requires TMDB_ACCESS_TOKEN via MCP host --auth-env.
    '''
    summary: "Discover movies with filters"
    example: "Find highly rated science fiction movies from 2024"
}

GET "/3/genre/movie/list" {
    toolName: getTmdbMovieGenres
    access: protected
    intent: "retrieve TMDB movie genres for filtering and lookup"
    summary: "Movie genre list"
    example: "List available movie genres"
}

GET "/3/trending/movie/{time_window}" {
    toolName: getTmdbTrendingMovies
    access: protected
    intent: "retrieve trending TMDB movies for a selected time window"
    summary: "Trending movies"
    example: "Show trending movies this week"
}

GET "/3/movie/{movie_id}/videos" {
    toolName: getTmdbMovieVideos
    access: protected
    intent: "retrieve videos such as trailers for a TMDB movie"
    summary: "Movie videos and trailers"
    example: "Show trailers for movie id 693134"
}

GET "/3/search/multi" {
    toolName: searchTmdbMulti
    access: protected
    intent: "search TMDB across movies, tv shows, and people"
    summary: "Multi search (movies, TV, people)"
    example: "Search TMDB for Dune across all media types"
}

GET "/3/movie/{movie_id}/release_dates" {
    toolName: getTmdbMovieReleaseDates
    access: protected
    intent: "retrieve release dates for a TMDB movie"
    summary: "Movie release dates"
    example: "When was movie id 693134 released?"
}

GET "/3/movie/{movie_id}/recommendations" {
    toolName: getTmdbMovieRecommendations
    access: protected
    intent: "retrieve recommendations for a TMDB movie"
    summary: "Movie recommendations"
    example: "Recommendations for movie id 693134"
}

GET "/3/movie/{movie_id}/similar" {
    toolName: getTmdbMovieSimilar
    access: protected
    intent: "retrieve similar movies for a TMDB movie"
    summary: "Retrieve similar movies"
    example: "Find similar movies to 693134"
}

GET "/3/movie/{movie_id}/reviews" {
    toolName: getTmdbMovieReviews
    access: protected
    intent: "retrieve reviews for a TMDB movie"
    summary: "Retrieve movie reviews"
    example: "Reviews for movie id 693134"
}