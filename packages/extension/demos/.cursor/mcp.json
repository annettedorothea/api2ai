{
    "mcpServers": {
        "todo-api-http-stateless": {
            "url": "http://127.0.0.1:3853/mcp",
            "headers": {
                "x-api-token": "demo-todo-api-key"
            }
        },
        "github-stdio": {
            "command": "node",
            "envFile": ".env.local",
            "args": [
                "./generated/cli/stdio-mcp-server.js",
                "./generated/tools/github-tools.js",
                "--base-url-env",
                "GITHUB_BASE_URL",
                "--auth-env",
                "GITHUB_TOKEN"
            ],
            "env": {
                "GITHUB_BASE_URL": "https://api.github.com"
            }
        },
        "bookings-api-oauth": {
            "url": "http://127.0.0.1:3870/mcp",
            "auth": {
                "CLIENT_ID": "mcp-demo-local"
            }
        },
        "open-meteo-stdio": {
            "command": "node",
            "args": [
                "./generated/cli/stdio-mcp-server.js",
                "./generated/tools/open-meteo-tools.js",
                "--base-url-env",
                "OPEN_METEO_BASE_URL"
            ],
            "env": {
                "OPEN_METEO_BASE_URL": "https://api.open-meteo.com"
            }
        },
        "open-meteo-geocoding-stdio": {
            "command": "node",
            "args": [
                "./generated/cli/stdio-mcp-server.js",
                "./generated/tools/open-meteo-geocoding-tools.js",
                "--base-url-env",
                "OPEN_METEO_GEOCODING_BASE_URL"
            ],
            "env": {
                "OPEN_METEO_GEOCODING_BASE_URL": "https://geocoding-api.open-meteo.com"
            }
        },
        "spaceflight-news-http-stateless": {
            "url": "http://127.0.0.1:3849/mcp"
        },
        "tmdb-stdio": {
            "command": "node",
            "envFile": ".env.local",
            "args": [
                "./generated/cli/stdio-mcp-server.js",
                "./generated/tools/tmdb-tools.js",
                "--base-url-env",
                "TMDB_BASE_URL",
                "--auth-env",
                "TMDB_ACCESS_TOKEN"
            ],
            "env": {
                "TMDB_BASE_URL": "https://api.themoviedb.org"
            }
        }
    }
}
