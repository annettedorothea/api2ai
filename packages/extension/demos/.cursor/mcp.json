{
    "mcpServers": {
        "stdio-api2ai-spaceflight-news": {
            "command": "node",
            "args": [
                "./generated/cli/stdio-mcp-server.js",
                "./generated/tools/spaceflight-news-tools.js",
                "--base-url-env",
                "SPACEFLIGHT_NEWS_BASE_URL"
            ],
            "env": {
                "SPACEFLIGHT_NEWS_BASE_URL": "https://api.spaceflightnewsapi.net"
            }
        },
        "http-api2ai-spaceflight-news": {
            "url": "http://127.0.0.1:3849/mcp"
        },
        "stdio-api2ai-tmdb": {
            "command": "node",
            "envFile": ".env.local",
            "args": [
                "./generated/cli/stdio-mcp-server.js",
                "./generated/tools/tmdb-tools.js",
                "--base-url-env",
                "TMDB_BASE_URL",
                "--auth-env",
                "TMDB_ACCESS_TOKEN"
            ],
            "env": {
                "TMDB_BASE_URL": "https://api.themoviedb.org"
            }
        },
        "stdio-api2ai-open-meteo": {
