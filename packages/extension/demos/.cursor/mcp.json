{
    "mcpServers": {
        "open-meteo": {
            "command": "node",
            "args": [
                "./generated/cli/stdio-mcp-server.js",
                "./generated/tools/open-meteo-tools.js",
                "--base-url-env",
                "OPEN_METEO_BASE_URL"
            ],
            "env": {
                "OPEN_METEO_BASE_URL": "https://api.open-meteo.com"
            }
        },
        "open-meteo-geocoding": {
            "command": "node",
            "args": [
                "./generated/cli/stdio-mcp-server.js",
                "./generated/tools/open-meteo-geocoding-tools.js",
                "--base-url-env",
                "OPEN_METEO_GEOCODING_BASE_URL"
            ],
            "env": {
                "OPEN_METEO_GEOCODING_BASE_URL": "https://geocoding-api.open-meteo.com"
            }
        },
        "github": {
            "command": "node",
            "envFile": ".env.local",
            "args": [
                "./generated/cli/stdio-mcp-server.js",
                "./generated/tools/github-tools.js",
                "--base-url-env",
                "GITHUB_BASE_URL",
                "--auth-env",
                "GITHUB_TOKEN",
                "--credential-validation",
                "opaque"
            ],
            "env": {
                "GITHUB_BASE_URL": "https://api.github.com"
            }
        },
        "tmdb": {
            "command": "node",
            "envFile": ".env.local",
            "args": [
                "./generated/cli/stdio-mcp-server.js",
                "./generated/tools/tmdb-tools.js",
                "--base-url-env",
                "TMDB_BASE_URL",
                "--auth-env",
                "TMDB_ACCESS_TOKEN",
                "--credential-validation",
                "opaque"
            ],
            "env": {
                "TMDB_BASE_URL": "https://api.themoviedb.org"
            }
        },
        "spaceflight-news": {
            "url": "http://127.0.0.1:3849/mcp"
        },
        "todo": {
            "url": "http://127.0.0.1:3853/mcp",
            "headers": {
                "x-api-token": "demo-todo-api-key"
            }
        },
        "bookings-oauth": {
            "url": "http://127.0.0.1:3872/mcp",
            "auth": {
                "CLIENT_ID": "mcp-demo-local"
            }
        },
        "cakes": {
            "url": "http://127.0.0.1:3874/mcp",
            "auth": {
                "CLIENT_ID": "mcp-demo-local"
            }
        },
        "banking-oauth": {
            "url": "http://127.0.0.1:3876/mcp",
            "auth": {
                "CLIENT_ID": "mcp-demo-local"
            }
        }
    }
}
