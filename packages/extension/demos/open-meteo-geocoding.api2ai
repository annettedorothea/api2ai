openapi "./openapi/open-meteo-geocoding.openapi.yaml"

GET "/v1/search" {
    toolName: openMeteoGeocodeSearch
    access: public
    intent: '''
        - Resolve a place name to WGS84 latitude and longitude (query: name, required).
        - Optional: countryCode (e.g. DE), language (e.g. de), count to limit matches.
        - Use before openMeteoForecast when the user gives a city or region, not coordinates.
        - Pick the result that matches the intended admin region (e.g. Baden-Württemberg vs. Hessen for "Ortenberg").
    '''
    example: "Find coordinates for Bernstein, Burgenland, Austria"
    annotations: {
        readOnlyHint: true
        idempotentHint: true
        openWorldHint: true
    }
}

