openapi "./openapi/cakes-api.openapi.yaml"

auth {
    in: header
    name: "Authorization"
    prefix: "Bearer "
}

GET "/cakes" {
    toolName: searchCakes
    access: protected
    intent: '''
        Search cake recipes by optional query q (title and keywords). Empty q returns all cakes.
    '''
    summary: "Search cake recipes by keyword"
    example: "Search cakes with Erdbeer"
    annotations: {
        readOnlyHint: true
        idempotentHint: true
        openWorldHint: true
    }
    response: '''
        HTTP 200 — top-level query, count, cakes array. Each cake: id, title, keywords, prepMinutes, servings.
        Use cakes[].id for getCake (e.g. schwarzwaelder-kirschtorte).
        Documented errors:
        HTTP 401 — Missing or invalid token
    '''
}

GET "/cakes/{cakeId}" {
    toolName: getCake
    access: protected
    intent: '''
        Fetch one cake recipe by path cakeId (from searchCakes).
    '''
    summary: "Get cake recipe by id"
    example: "Get Schwarzwälder Kirschtorte recipe"
    annotations: {
        readOnlyHint: true
        idempotentHint: true
        openWorldHint: true
    }
    response: '''
        HTTP 200 — top-level property cake (id, title, keywords, prepMinutes, servings, ingredients).
        Documented errors:
        HTTP 401 — Missing or invalid token
        HTTP 404 — Unknown cake id
    '''
}
