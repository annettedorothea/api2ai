openapi "./openapi/spaceflight-news.openapi.yaml"

GET "/v4/articles/" {
    toolName: listSpaceflightArticles
    access: public
    prepare: {
        optionalParams: [limit]
    }
    intent: '''
        - List recent spaceflight news articles (pagination: limit, offset, ordering).
        - Query limit caps how many articles are returned (default 10, max 10).
        - Response contains title, summary teaser, and url per item — not the full article body.
        - Use search, has_launch, or news_site filters for SpaceX, launches, or specific outlets.
        - Follow result url only when full text is needed (same pattern for blogs and reports tools).
    '''
    summary: "List spaceflight articles (limit validated, teaser only; full text at response url)"
    example: "Get the latest 5 articles"
    params: {
        limit: {
            description: "Number of results per page (default 10, max 10)."
            example: "10"
        }
    }
}

GET "/v4/articles/{id}/" {
    toolName: getSpaceflightArticleById
    access: public
    intent: "get one spaceflight article by id; API returns summary teaser only, full article text at url"
    summary: "Get article by ID (teaser only; full text at response url)"
    example: "Get article with id 1"
}

GET "/v4/blogs/" {
    toolName: listSpaceflightBlogs
    access: public
    prepare: {
        optionalParams: [limit]
    }
    intent: '''
        - List recent spaceflight blog posts (pagination: limit, offset, ordering).
        - Query limit caps how many blog posts are returned (default 10, max 10).
        - Response contains title, summary teaser, and url per item — not the full post body.
        - Use search, has_launch, or news_site filters for SpaceX, launches, or specific outlets.
        - Follow result url only when full text is needed (same pattern for articles and reports tools).
    '''
    summary: "List spaceflight blog posts (limit validated, teaser only; full text at response url)"
    example: "Get the latest 5 blog posts"
    params: {
        limit: {
            description: "Number of results per page (default 10, max 10)."
            example: "10"
        }
    }
}

GET "/v4/blogs/{id}/" {
    toolName: getSpaceflightBlogById
    access: public
    intent: "get one spaceflight blog post by id; API returns summary teaser only, full post text at url"
    summary: "Get blog post by ID (teaser only; full text at response url)"
    example: "Get blog post with id 1"
}

GET "/v4/reports/" {
    toolName: listSpaceflightReports
    access: public
    prepare: {
        optionalParams: [limit]
    }
    intent: '''
        - List recent spaceflight reports (pagination: limit, offset, ordering).
        - Query limit caps how many reports are returned (default 10, max 10).
        - Response contains title, summary teaser, and url per item — not the full report body.
        - Use search or news_site filters for specific outlets or topics.
        - Follow result url only when full text is needed (same pattern for articles and blogs tools).
    '''
    summary: "List spaceflight reports (limit validated, teaser only; full text at response url)"
    example: "Get the latest 5 reports"
    params: {
        limit: {
            description: "Number of results per page (default 10, max 10)."
            example: "10"
        }
    }
}

GET "/v4/reports/{id}/" {
    toolName: getSpaceflightReportById
    access: public
    intent: "get one spaceflight report by id; API returns summary teaser only, full report text at url"
    summary: "Get report by ID (teaser only; full text at response url)"
    example: "Get report with id 1"
}

GET "/v4/info/" {
    toolName: getSpaceflightInfo
    access: public
    intent: "retrieve spaceflight API metadata and news sites"
    summary: "Spaceflight News API metadata"
    example: "Show API info and available news sites"
}