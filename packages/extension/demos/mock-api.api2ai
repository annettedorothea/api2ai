openapi "./openapi/mock-api.openapi.yaml"

auth {
    in: header
    name: "Authorization"
    prefix: "Bearer "
    fromJwt: "customerId"
}

GET "/orders/{customerId}" {
    toolName: "listCustomerOrders"
    intent: "list orders for the authenticated customer from the JWT"
    summary: "List customer orders"
    example: "List my orders"
}

POST "/login/{customerId}" {
    toolName: "login"
    intent: "login the customer"
    summary: "Login customer"
    example: "Login"
    public
}