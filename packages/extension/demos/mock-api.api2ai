openapi "./openapi/mock-api.openapi.yaml"

auth {
    in: header
    name: "Authorization"
    prefix: "Bearer "
}

GET "/orders/{customerId}" {
    toolName: "listCustomerOrders"
    access: checked {
        optionalParams: ["customerId"]
    }
    intent: "list orders for the authenticated customer from the JWT, when the customerId is empty, it will be filled from the JWT"
    summary: "List customer orders"
    example: "List my orders"
}

POST "/login/{customerId}" {
    toolName: "login"
    access: public
    intent: "login the customer"
    summary: "Login customer"
    example: "Login"
}
