{
    "name": "api2ai-demos",
    "private": true,
    "type": "module",
    "scripts": {
        "init": "node ./scripts/init.mjs",
        "init:foreground": "INIT_FOREGROUND=1 node ./scripts/init.mjs",
        "demo:kill-all": "LOG_SERVICE_PREFIX=kill-all node ./scripts/kill-all-demos.mjs",
        "demo:bookings-api": "LOG_SERVICE_PREFIX=bookings-api node ./bookings-api/server.mjs",
        "demo:bookings-api:kill": "node ./bookings-api/kill-server.mjs",
        "demo:todo-api": "LOG_SERVICE_PREFIX=todo-api node ./todo-api/server.mjs",
        "demo:todo-api:kill": "node ./todo-api/kill-server.mjs",
        "demo:oauth-idp": "LOG_SERVICE_PREFIX=oauth-idp node ./oauth-idp/server.mjs",
        "demo:oauth-idp:kill": "node ./oauth-idp/kill-server.mjs",
        "demo:oauth-idp-oidc": "LOG_SERVICE_PREFIX=oauth-idp-oidc BOOKINGS_OAUTH_IDP_PORT=3861 OAUTH_IDP_SIGN_ALG=RS256 node ./oauth-idp/server.mjs",
        "demo:oauth-idp-oidc:kill": "node ./oauth-idp/kill-server-oidc.mjs",
        "demo:cakes-api": "LOG_SERVICE_PREFIX=cakes-api node ./cakes-api/server.mjs",
        "demo:cakes-api:kill": "node ./cakes-api/kill-server.mjs",
        "demo:banking-api": "LOG_SERVICE_PREFIX=banking-api node ./banking-api/server.mjs",
        "demo:banking-api:kill": "node ./banking-api/kill-server.mjs",
        "demo:enterprise-idp": "LOG_SERVICE_PREFIX=enterprise-idp ENTERPRISE_IDP_PORT=3862 BOOKINGS_OAUTH_IDP_PORT=3862 OAUTH_IDP_SIGN_ALG=RS256 node ./oauth-idp/server.mjs",
        "demo:enterprise-idp:kill": "node ./oauth-idp/kill-server-enterprise.mjs",
        "demo:mcp-oauth:bookings-oauth": "node ./scripts/start-mcp-oauth.mjs bookings-oauth",
        "demo:mcp-oauth:cakes": "node ./scripts/start-mcp-oauth.mjs cakes",
        "demo:mcp-oauth:banking-oauth": "node ./scripts/start-mcp-oauth.mjs banking-oauth",
        "demo:mcp-oauth:kill": "node ./scripts/kill-mcp-oauth.mjs",
        "demo:mcp-http:all": "node ./scripts/start-mcp-http-all.mjs",
        "demo:mcp-http:kill": "node ./scripts/kill-mcp-http-all.mjs",
        "demo:mcp-http:todo": "node ./scripts/start-mcp-http.mjs todo",
        "demo:mcp-http:spaceflight-news": "node ./scripts/start-mcp-http.mjs spaceflight-news",
        "generate:spaceflight-tools": "node ./scripts/generate.mjs spaceflight-news.api2ai generated/tools/spaceflight-news-tools.ts && npm run format",
        "generate:tmdb-tools": "node ./scripts/generate.mjs tmdb.api2ai generated/tools/tmdb-tools.ts && npm run format",
        "generate:github-tools": "node ./scripts/generate.mjs github.api2ai generated/tools/github-tools.ts && npm run format",
        "generate:open-meteo-tools": "node ./scripts/generate.mjs open-meteo.api2ai generated/tools/open-meteo-tools.ts && npm run format",
        "generate:open-meteo-geocoding-tools": "node ./scripts/generate.mjs open-meteo-geocoding.api2ai generated/tools/open-meteo-geocoding-tools.ts && npm run format",
        "generate:bookings-api-tools": "node ./scripts/generate.mjs bookings-api.api2ai generated/tools/bookings-api-tools.ts && npm run format",
        "generate:cakes-tools": "node ./scripts/generate.mjs cakes.api2ai generated/tools/cakes-tools.ts && npm run format",
        "generate:banking-tools": "node ./scripts/generate.mjs banking.api2ai generated/tools/banking-tools.ts && npm run format",
        "generate:todo-tools": "node ./scripts/generate.mjs todo.api2ai generated/tools/todo-tools.ts && npm run format",
        "generate:all": "node ./scripts/generate-all.mjs && npm run format",
        "build:generated": "tsc -p tsconfig.generated.json",
        "test": "vitest run",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "check": "npm run format:check && npm run typecheck && npm run lint"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.29.0",
        "jose": "^6.2.3",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "~20.17.48",
        "eslint": "^10.4.0",
        "prettier": "^3.8.3",
        "typescript": "~5.8.3",
        "typescript-eslint": "^8.59.4",
        "vitest": "~3.1.3"
    }
}
