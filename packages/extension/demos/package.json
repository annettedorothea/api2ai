{
    "name": "api2ai-demos",
    "private": true,
    "type": "module",
    "scripts": {
        "start": "node ./scripts/start.mjs",
        "start:foreground": "START_FOREGROUND=1 node ./scripts/start.mjs",
        "demo:kill-all": "LOG_SERVICE_PREFIX=kill-all node ./scripts/kill-all-demos.mjs",
        "generate:all": "node ./scripts/generate-all.mjs && npm run format",
        "build:generated": "tsc -p tsconfig.generated.json",
        "test": "vitest run",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "check": "npm run format:check && npm run typecheck && npm run lint",
        "mcp:inspect": "node ./scripts/mcp-inspect.mjs"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.29.0",
        "jose": "^6.2.3",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "~22.19.20",
        "eslint": "^10.4.1",
        "prettier": "^3.8.3",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.60.1",
        "vitest": "~4.1.8"
    }
}
