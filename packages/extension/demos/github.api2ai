openapi "./openapi/github-user-min.openapi.yaml"

auth {
    in: header
    name: "Authorization"
    prefix: "Bearer "
    hooks: {
        verifyCredential: true
    }
}

GET "/user" {
    toolName: getGitHubAuthenticatedUser
    access: protected
    intent: "return the GitHub user profile for the authenticated PAT; use to confirm which account the token represents before calling repo-scoped tools"
    summary: "Get the authenticated user"
    example: "No path or query parameters"
    annotations: {
        readOnlyHint: true
        idempotentHint: true
        openWorldHint: true
    }
}

GET "/user/repos" {
    toolName: listGitHubUserRepos
    access: protected
    intent: '''
        - List repositories the authenticated PAT can access (pagination via query page, per_page).
        - Use to discover owner/repo names before getGitHubRepository.
        - Helpful when GET /repos/{owner}/{repo} returns 404 (wrong owner, private repo, or missing scope).
        - Requires a PAT with repo read access; token comes from MCP host --auth-env.
    '''
    summary: "List repositories for the authenticated user"
    example: "First page, 10 per page: query per_page=10 page=1"
    annotations: {
        readOnlyHint: true
        idempotentHint: true
        openWorldHint: true
    }
}

GET "/repos/{owner}/{repo}" {
    toolName: getGitHubRepository
    access: protected
    intent: "fetch GitHub repository metadata when the PAT can read the repo"
    summary: "Get a repository"
    example: "Get public repo octocat/Hello-World"
    annotations: {
        readOnlyHint: true
        idempotentHint: true
        openWorldHint: true
    }
}
