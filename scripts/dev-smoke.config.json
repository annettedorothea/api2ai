{
    "cliBin": "./packages/cli/bin/cli.js",
    "scenarios": {
        "open-meteo": {
            "kind": "smoke-generated",
            "module": "./packages/extension/demos/generated/tools/open-meteo-tools.js",
            "tool": "openMeteoForecast"
        },
        "tmdb": {
            "kind": "smoke-generated",
            "module": "./packages/extension/demos/generated/tools/tmdb-tools.js",
            "tool": "searchTmdbMovies",
            "argsJson": "{\"query\":{\"query\":\"Dune\"}}"
        },
        "mock-api": {
            "kind": "smoke-generated",
            "module": "./packages/extension/demos/generated/tools/mock-api-tools.js",
            "tool": "listCustomerOrders"
        },
        "mcp-open-meteo": {
            "kind": "mcp-serve",
            "env": {
                "OPEN_METEO_BASE_URL": "https://api.open-meteo.com"
            },
            "serveScript": "./packages/extension/demos/generated/cli/mcp-serve.js",
            "toolsModule": "./packages/extension/demos/generated/tools/open-meteo-tools.js",
            "baseUrlEnv": "OPEN_METEO_BASE_URL"
        },
        "mcp-mock-api": {
            "kind": "node-script",
            "script": "./packages/cli/out/test/e2e/mcp-smoke-mock-api.js"
        }
    },
    "smoke": ["open-meteo", "tmdb", "mock-api"],
    "e2e": ["mcp-mock-api"]
}
